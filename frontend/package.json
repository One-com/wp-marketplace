{
  "name": "wp-marketplace",
  "version": "1.0.0-beta.5",
  "description": "React-based wp plugins marketplace module.",
  "main": "standalone/index.es.js",
  "module": "standalone/index.es.js",
  "exports": {
    ".": {
      "import": "./standalone/index.es.js"
    },
    "./style.css": "./standalone/style.css"
  },
  "files": [
    "standalone",
    "README.md"
  ],
  "scripts": {
    "start": "wp-scripts start",
    "build": "webpack --config webpack.wp.js",
    "build:standalone": "vite build",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\""
  },
  "peerDependencies": {
    "react": ">=18 || >=19",
    "react-dom": ">=18 || >=19"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "@wordpress/scripts": "^26.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.2.5",
    "vite": "^5.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/One-com/wp-marketplace.git"
  },
  "author": "One.com",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "@group.one/gravity": "^5.22.1",
    "react-i18next": "^15.7.3"
  }
}
