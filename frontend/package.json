{
  "name": "wp-marketplace",
  "version": "1.0.0-beta.5",
  "description": "React-based wp plugins marketplace module.",
  "main": "standalone/index.es.js",
  "module": "standalone/index.es.js",
  "exports": {
    ".": {
      "import": "./standalone/index.es.js"
    },
    "./style.css": "./standalone/style.css"
  },
  "files": [
    "standalone",
    "README.md"
  ],
  "scripts": {
    "start": "npm run minify-css && node copy-build.js --watch & wp-scripts start",
    "build": "npm run minify-css && webpack --config webpack.wp.js && node copy-build.js",
    "build:standalone": "vite build",
    "copy": "node copy-build.js",
    "lint": "eslint 'src/**/*.{js,jsx}'",
    "lint:fix": "eslint . --fix",
    "format": "prettier --log-level=error --write 'src/**/*.{js,jsx,css,scss}'",
    "minify-css": "cleancss -o ../assets/min-css/marketplace.min.css ../css/marketplace.css"
  },
  "peerDependencies": {
    "react": ">=18 || >=19",
    "react-dom": ">=18 || >=19"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "@wordpress/scripts": "^31.1.0",
    "clean-css-cli": "^5.6.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "vite": "^7.3.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "overrides": {
    "webpack-dev-server": "^5.2.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/One-com/wp-marketplace.git"
  },
  "author": "One.com",
  "license": "GPL-2.0-or-later",
  "dependencies": {
    "@eslint/js": "^9.39.2",
    "@group.one/gravity": "^5.22.1",
    "globals": "^16.5.0",
    "mixpanel-browser": "^2.72.0",
    "react-i18next": "^15.7.3"
  }
}
