{
  "name": "groupone/marketplace",
  "description": "Marketplace Module for WordPress plugins",
  "type": "library",
  "autoload": {
    "psr-4": {
      "Groupone\\Marketplace\\": "backend/src/"
    }
  },
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcsstandards/phpcsutils": "^1.0",
    "phpcsstandards/phpcsextra": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}