{
  "name": "groupone/marketplace",
  "description": "Marketplace Module for WordPress plugins",
  "type": "library",
  "autoload": {
    "psr-4": {
      "Groupone\\Marketplace\\": "backend/src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Groupone\\Marketplace\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "mockery/mockery": "^1.5",
    "brain/monkey": "^2.6",
    "10up/wp_mock": "^0.5"
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-html coverage --coverage-text",
    "test-coverage-summary": "phpunit --coverage-text | grep -A 10 'Code Coverage'",
    "test-model": "phpunit tests/Models/",
    "test-controller": "phpunit tests/Controllers/",
    "test-verbose": "phpunit --testdox"
  }
}
